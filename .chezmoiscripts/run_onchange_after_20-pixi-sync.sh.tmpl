#!/usr/bin/env bash
# Install/update/remove tools so ~/.pixi matches the manifest.
# Re-runs whenever the manifest changes: {{ include "dot_pixi/manifests/pixi-global.toml" | sha256sum }}
set -euo pipefail

echo "Syncing tools with pixi (first run downloads ~300 MB)..."
"$HOME/.pixi/bin/pixi" global sync
