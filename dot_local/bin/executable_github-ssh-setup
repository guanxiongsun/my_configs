#!/usr/bin/env bash
# github-ssh-setup: give this machine its own SSH key for GitHub and register it.
#
#   1. reuse ~/.ssh/id_ed25519, or generate a new one
#   2. check GitHub is reachable over SSH (falls back to ssh.github.com:443 when port 22 is blocked)
#   3. upload the public key with the GitHub CLI (device-code login, works on headless servers),
#      or print it for pasting at https://github.com/settings/ssh/new
#
# Safe to re-run at any time. Non-interactive runs never prompt; they only print what to do.
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.pixi/bin:$PATH"

key="$HOME/.ssh/id_ed25519"
user="${USER:-$(id -un)}"
local_config="$HOME/.ssh/config.local"
title="$(hostname -s 2>/dev/null || hostname) ($(date +%Y-%m-%d))"

say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }

interactive() { [ -z "${NONINTERACTIVE:-}" ] && { : </dev/tty; } 2>/dev/null; }

ask() { # ask "question" default(y|n)
  local reply hint="[y/N]"
  [ "$2" = y ] && hint="[Y/n]"
  interactive || { [ "$2" = y ]; return; }
  read -r -p "$1 $hint " reply </dev/tty || reply=""
  case "${reply:-$2}" in [Yy]*) return 0 ;; *) return 1 ;; esac
}

# Prints: ok | denied | unreachable
probe() {
  local out
  out="$(ssh -T -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=yes "$@" git@github.com 2>&1 || true)"
  case "$out" in
    *"successfully authenticated"*) echo ok ;;
    *"Permission denied"*) echo denied ;;
    *) echo unreachable ;;
  esac
}

if ! command -v ssh >/dev/null 2>&1 || ! command -v ssh-keygen >/dev/null 2>&1; then
  warn "OpenSSH client (ssh, ssh-keygen) not found; skipping GitHub SSH setup."
  exit 0
fi

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

# 1. Key
if [ ! -f "$key" ]; then
  say "Generating a new SSH key for this machine: ${key/#$HOME/~}"
  if interactive; then
    echo "    (a passphrase is optional; the ssh-agent zsh plugin asks for it once per session)"
    ssh-keygen -t ed25519 -C "$user@$title" -f "$key" </dev/tty
  else
    ssh-keygen -q -t ed25519 -C "$user@$title" -f "$key" -N ""
  fi
fi
[ -f "$key.pub" ] || ssh-keygen -y -f "$key" >"$key.pub"

# 2. Connectivity
status="$(probe)"
if [ "$status" = unreachable ]; then
  status_443="$(probe -p 443 -o HostName=ssh.github.com -o HostKeyAlias=github.com)"
  if [ "$status_443" != unreachable ]; then
    say "Port 22 to GitHub is blocked here; using ssh.github.com:443 (written to ${local_config/#$HOME/~})"
    {
      printf '\n# Added by github-ssh-setup: port 22 is blocked on this network.\n'
      printf 'Host github.com\n    HostName ssh.github.com\n    Port 443\n    HostKeyAlias github.com\n'
    } >>"$local_config"
    chmod 600 "$local_config"
    status="$status_443"
  else
    warn "Can't reach GitHub over SSH (port 22 or 443). HTTPS still works; re-run github-ssh-setup later."
    exit 0
  fi
fi

if [ "$status" = ok ]; then
  say "GitHub SSH access already works on this machine."
  exit 0
fi

# 3. Register the key
pub="$(cat "$key.pub")"
manual() {
  echo
  echo "Add this public key at https://github.com/settings/ssh/new (title: $title):"
  echo
  echo "    $pub"
  echo
  if interactive; then
    read -r -p "Press Enter once it's added... " _ </dev/tty || true
  else
    echo "Then check with: ssh -T git@github.com"
    exit 0
  fi
}

if ! interactive; then
  manual
elif command -v gh >/dev/null 2>&1 && ask "Upload the key to GitHub with the GitHub CLI (one browser/device-code approval)?" y; then
  logged_in_here=""
  if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    say "Logging in to GitHub. Open the URL on any device and enter the code shown."
    gh auth login --hostname github.com --git-protocol ssh --skip-ssh-key --web --scopes admin:public_key </dev/tty
    logged_in_here=1
  fi
  if ! out="$(gh ssh-key add "$key.pub" --title "$title" 2>&1)"; then
    case "$out" in
      *"already"*) ;;
      *scope* | *admin:public_key*)
        gh auth refresh --hostname github.com --scopes admin:public_key </dev/tty
        gh ssh-key add "$key.pub" --title "$title" ;;
      *) echo "$out" >&2; warn "gh couldn't add the key."; manual ;;
    esac
  fi
  if [ -n "$logged_in_here" ] && ! ask "Stay logged in to the GitHub CLI on this machine?" n; then
    gh auth logout --hostname github.com >/dev/null 2>&1 </dev/tty || true
    say "Logged out of gh (the SSH key stays registered)."
  fi
else
  manual
fi

# 4. Verify
if [ "$(probe)" = ok ]; then
  say "Done: $(ssh -T git@github.com 2>&1 | head -n 1)"
else
  warn "GitHub still rejects the key. Check https://github.com/settings/keys, then run: ssh -T git@github.com"
  exit 1
fi
