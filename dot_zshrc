# ~/.zshrc: interactive zsh. Managed by chezmoi (github.com/guanxiongsun/my_configs).
# Edit with `chezmoi edit ~/.zshrc`; put machine-specific settings in ~/.zshrc.local.

# --- history & options -------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments no_beep
bindkey -e
# Up/Down search history for what's typed so far: `ssh` + Up recalls the last `ssh ...` command.
# Terminals send ^[[A or ^[OA for Up. Keep above the plugins, or recalled lines aren't highlighted.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search '^[OB' down-line-or-beginning-search
# Home, End, Delete and Ctrl-Left/Right (word by word); plain zsh leaves them unbound, so they type
# `~` or `;5D`. Home/End: xterm sends ^[[H ^[OH / ^[[F ^[OF, tmux and screen send ^[[1~ / ^[[4~.
bindkey '^[[H' beginning-of-line '^[OH' beginning-of-line '^[[1~' beginning-of-line
bindkey '^[[F' end-of-line '^[OF' end-of-line '^[[4~' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5D' backward-word '^[[1;5C' forward-word

# --- completion paths (before plugins, so ez-compinit picks them up) ----------
[[ -d "$HOME/.pixi/completions/zsh" ]] && fpath=("$HOME/.pixi/completions/zsh" $fpath)
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' menu select

# --- plugins (antidote) --------------------------------------------------------
# oh-my-zsh plugins expect a cache dir.
ZSH_CACHE_DIR="$XDG_CACHE_HOME/zsh"
[[ -d "$ZSH_CACHE_DIR/completions" ]] || mkdir -p "$ZSH_CACHE_DIR/completions"
# ssh-agent: one agent per host (cached in ~/.ssh/environment-$SHORT_HOST, safe with NFS-shared homes);
# keys are added on first use (AddKeysToAgent) and a forwarded agent is reused.
SHORT_HOST="${HOST%%.*}"
zstyle :omz:plugins:ssh-agent lazy yes
zstyle :omz:plugins:ssh-agent agent-forwarding yes
zstyle :omz:plugins:ssh-agent quiet yes

if [[ -r "$HOME/.local/share/antidote/antidote.zsh" ]]; then
  source "$HOME/.local/share/antidote/antidote.zsh"
  antidote load   # regenerates ~/.zsh_plugins.zsh when ~/.zsh_plugins.txt changes
fi

# --- tools ---------------------------------------------------------------------
# fzf key bindings (Ctrl-R history, Ctrl-T files, Alt-C cd); only in a real terminal
[[ -t 0 && -t 1 ]] && (( $+commands[fzf] )) && source <(fzf --zsh)
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# conda (Miniforge), without letting `conda init` edit rc files. Use `conda activate <env>`.
for _conda in "$HOME/miniforge3" "$HOME/miniconda3" "$HOME/anaconda3"; do
  if [[ -r "$_conda/etc/profile.d/conda.sh" ]]; then
    source "$_conda/etc/profile.d/conda.sh"
    break
  fi
done
unset _conda

# HPC module systems (Lmod, Environment Modules). pixi's zsh never reads /etc/profile.d, so load the
# `module` command from the location their bash init exported.
for _m in "${LMOD_PKG:-}/init/zsh" "${MODULESHOME:-}/init/zsh"; do
  if [[ -r "$_m" ]] && ! (( $+functions[module] )); then
    source "$_m"
    break
  fi
done
unset _m

[[ -r "$XDG_CONFIG_HOME/shell/aliases.sh" ]] && source "$XDG_CONFIG_HOME/shell/aliases.sh"

# --- prompt --------------------------------------------------------------------
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
else
  PROMPT='%B%F{yellow}%n%f@%F{blue}%m%f%b %F{cyan}%~%f %(?.%F{green}.%F{red})➜%f '
fi

# --- machine-local overrides ------------------------------------------------------
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
